rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function usuarioActivo() {
      return autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo
          != false;
    }

    function esAdmin() {
      return usuarioActivo()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
          == "administrador";
    }

    function esRepartidor() {
      return usuarioActivo()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
          == "repartidor";
    }

    function transicionValida(actual, siguiente) {
      return (actual == "pendiente"
          && siguiente in ["confirmado", "cancelado"])
        || (actual == "confirmado"
          && siguiente in ["en_preparacion", "cancelado"])
        || (actual == "en_preparacion"
          && siguiente in ["en_camino", "listo_para_retirar"])
        || (actual in ["en_camino", "listo_para_retirar"]
          && siguiente == "entregado");
    }

    function historialAppendOnly() {
      return request.resource.data.historial is list
        && request.resource.data.historial.size() == resource.data.historial.size() + 1
        && request.resource.data.historial
          == resource.data.historial.concat([
            request.resource.data.historial[resource.data.historial.size()]
          ]);
    }

    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol == "cliente"
        && request.resource.data.activo == true
        && request.resource.data.correo is string
        && request.resource.data.correo.matches('.*@uleam\\.edu\\.ec$')
        && request.auth.token.email == request.resource.data.correo;
      allow update: if esAdmin()
        || (usuarioActivo()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["nombre", "apellido", "correo", "updated_at"])
          && request.resource.data.rol == resource.data.rol);
      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read: if usuarioActivo();
      allow create: if esAdmin()
        && request.resource.data.categoria_id is string
        && exists(/databases/$(database)/documents/categorias/$(request.resource.data.categoria_id))
        && get(/databases/$(database)/documents/categorias/$(request.resource.data.categoria_id)).data.activo
          == true;
      allow delete: if esAdmin();
      allow update: if esAdmin()
        || (usuarioActivo()
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
            == "cliente"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["stock_actual", "stock_movimiento_id", "updated_at"])
          && request.resource.data.stock_actual is number
          && request.resource.data.stock_actual >= 0
          && request.resource.data.stock_actual < resource.data.stock_actual
          && request.resource.data.stock_movimiento_id is string
          && existsAfter(/databases/$(database)/documents/movimientos_stock/$(request.resource.data.stock_movimiento_id))
          && getAfter(/databases/$(database)/documents/movimientos_stock/$(request.resource.data.stock_movimiento_id)).data.producto_id
            == productoId
          && getAfter(/databases/$(database)/documents/movimientos_stock/$(request.resource.data.stock_movimiento_id)).data.tipo
            == "salida"
          && getAfter(/databases/$(database)/documents/movimientos_stock/$(request.resource.data.stock_movimiento_id)).data.cantidad
            == resource.data.stock_actual - request.resource.data.stock_actual
          && getAfter(/databases/$(database)/documents/movimientos_stock/$(request.resource.data.stock_movimiento_id)).data.usuario_id
            == request.auth.uid);
    }

    match /categorias/{categoriaId} {
      allow read: if usuarioActivo();
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    match /zonas_delivery/{zonaId} {
      allow read: if usuarioActivo();
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    match /movimientos_stock/{movimientoId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        || (usuarioActivo()
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
            == "cliente"
          && request.resource.data.keys().hasOnly([
            "producto_id", "tipo", "cantidad", "motivo", "usuario_id", "created_at"
          ])
          && request.resource.data.tipo == "salida"
          && request.resource.data.usuario_id == request.auth.uid
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad > 0
          && existsAfter(/databases/$(database)/documents/productos/$(request.resource.data.producto_id))
          && getAfter(/databases/$(database)/documents/productos/$(request.resource.data.producto_id)).data.stock_actual
            == get(/databases/$(database)/documents/productos/$(request.resource.data.producto_id)).data.stock_actual
              - request.resource.data.cantidad
          && getAfter(/databases/$(database)/documents/productos/$(request.resource.data.producto_id)).data.stock_movimiento_id
            == movimientoId);
      allow update, delete: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if usuarioActivo()
        && (esAdmin()
          || resource.data.cliente_id == request.auth.uid
          || resource.data.repartidor_id == request.auth.uid);
      allow create: if usuarioActivo()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
          == "cliente"
        && request.resource.data.cliente_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "cliente_id", "cliente_nombre", "tipo", "estado", "subtotal",
          "tarifa_envio", "total", "zona_id", "direccion_entrega",
          "forma_pago", "comprobante_url", "repartidor_id", "notas",
          "detalles", "historial", "created_at"
        ])
        && request.resource.data.keys().hasAll([
          "cliente_id", "cliente_nombre", "tipo", "estado", "subtotal",
          "tarifa_envio", "total", "zona_id", "direccion_entrega",
          "forma_pago", "comprobante_url", "repartidor_id", "notas",
          "detalles", "historial", "created_at"
        ])
        && request.resource.data.estado == "pendiente"
        && request.resource.data.tipo in ["delivery", "retiro"]
        && request.resource.data.forma_pago in ["efectivo", "transferencia"]
        && request.resource.data.historial is list
        && request.resource.data.historial.size() == 1
        && request.resource.data.detalles is list
        && request.resource.data.subtotal is number
        && request.resource.data.tarifa_envio is number
        && request.resource.data.total is number;
      allow update: if esAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["estado", "historial", "updated_at", "repartidor_id", "notas"])
          && transicionValida(resource.data.estado, request.resource.data.estado)
          && (request.resource.data.estado != "en_camino"
            || (request.resource.data.tipo == "delivery"
              && request.resource.data.repartidor_id is string
              && get(/databases/$(database)/documents/usuarios/$(request.resource.data.repartidor_id)).data.rol
                == "repartidor"
              && get(/databases/$(database)/documents/usuarios/$(request.resource.data.repartidor_id)).data.activo
                != false))
          && (request.resource.data.estado != "listo_para_retirar"
            || request.resource.data.tipo == "retiro")
          && historialAppendOnly()
        || usuarioActivo()
          && resource.data.repartidor_id == request.auth.uid
          && esRepartidor()
          && resource.data.estado in ["en_camino", "listo_para_retirar"]
          && request.resource.data.estado == "entregado"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["estado", "historial", "updated_at"])
          && historialAppendOnly();
      allow delete: if esAdmin();
    }
  }
}
