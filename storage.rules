rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() {
      return request.auth != null;
    }

    function usuarioActivo() {
      return autenticado()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo
          != false;
    }

    function esAdmin() {
      return usuarioActivo()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol
          == "administrador";
    }

    match /comprobantes/{uid}/{nombreArchivo} {
      allow create: if usuarioActivo()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if usuarioActivo() && (request.auth.uid == uid || esAdmin());
      allow update, delete: if false;
    }

    match /productos/{uid}/{nombreArchivo} {
      allow create: if esAdmin()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if usuarioActivo();
      allow update, delete: if esAdmin();
    }
  }
}
